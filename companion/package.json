{
  "name": "notice-decoder-companion",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "description": "Android companion for Notice Decoder: reads chosen WhatsApp groups from the notification shade, decodes notices on the phone and writes events into the phone calendar.",
  "scripts": {
    "sync-engine": "node scripts/sync-engine.mjs",
    "start": "npm run sync-engine && expo start --dev-client",
    "android": "npm run sync-engine && expo run:android",
    "prebuild": "npm run sync-engine && expo prebuild --platform android",
    "build:apk": "npm run sync-engine && eas build --platform android --profile preview",
    "test": "node test/pipeline.test.mjs",
    "doctor": "npx expo-doctor"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~57.0.29",
    "expo-background-task": "~57.0.21",
    "expo-calendar": "~57.0.5",
    "expo-dev-client": "~57.0.0",
    "expo-linking": "~57.0.11",
    "expo-notifications": "~57.0.0",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-android-notification-listener": "^5.0.1",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@expo/config-plugins": "~57.0.0"
  }
}
